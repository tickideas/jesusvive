# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jesusvive"

# Event
NEXT_PUBLIC_EVENT_DATE="2026-05-16T19:00:00-03:00"
NEXT_PUBLIC_EVENT_NAME="Jesus Vive Brasil"

# WhatsApp (Brazilian number) — used for wa.me deep-link buttons
NEXT_PUBLIC_WHATSAPP_NUMBER="+5511999999999"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Olá! Quero saber mais sobre o evento Jesus Vive Brasil."

# Twilio WhatsApp Business API (outbound templates)
# Leave TWILIO_ACCOUNT_SID empty to disable sending (no-op, logged).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sender in WhatsApp format, e.g. "whatsapp:+5511999999999"
TWILIO_WHATSAPP_FROM=""
# Approved Content Template SIDs (HXxxxxxxxx...) — pt_BR utility category
TWILIO_TEMPLATE_CONFIRMATION_SID=""
TWILIO_TEMPLATE_REMINDER_48H_SID=""
TWILIO_TEMPLATE_REMINDER_24H_SID=""
TWILIO_TEMPLATE_REMINDER_1H_SID=""

# Secret used to authenticate cron calls to /api/cron/reminders
CRON_SECRET=""

# Set to "1" only in local dev to bypass Twilio webhook signature validation
# when testing /api/twilio/inbound with curl. Never enable in production.
TWILIO_SKIP_SIGNATURE_VALIDATION=""

# Streaming (event day)
NEXT_PUBLIC_YOUTUBE_LIVE_ID=""

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=""

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Admin dashboard at /admin (basic auth)
# Both must be set; if either is empty, /admin returns 503.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
